<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.9"/>

  <object class="AdwOverlaySplitView" id="rootContent">
    <property name="sidebar-position">start</property>
    <property name="min-sidebar-width">220</property>
    <property name="max-sidebar-width">300</property>
    <property name="sidebar-width-fraction">0.25</property>
    <property name="enable-hide-gesture">true</property>
    <property name="enable-show-gesture">true</property>

    <property name="sidebar">
      <object class="GtkOverlay" id="sidebarOverlay">
        <property name="child">
          <object class="AdwToolbarView" id="sidebarToolbar">
            <property name="top-bar-style">flat</property>
            <child type="top">
              <object class="AdwHeaderBar" id="sidebarHeader">
                <property name="show-start-title-buttons">false</property>
                <property name="show-end-title-buttons">false</property>
                <style>
                  <class name="glup-sidebar-header"/>
                </style>
                <property name="title-widget">
                  <object class="GtkLabel">
                    <property name="label">Sessions</property>
                    <property name="ellipsize">end</property>
                    <style>
                      <class name="heading"/>
                    </style>
                  </object>
                </property>
                <child type="start">
                  <object class="GtkButton" id="hideSidebarBtn">
                    <property name="icon-name">sidebar-show-symbolic</property>
                    <property name="tooltip-text">Hide Sidebar</property>
                  </object>
                </child>
                <child type="start">
                  <object class="GtkMenuButton" id="appMenuSidebarBtn">
                    <property name="icon-name">view-more-symbolic</property>
                    <property name="tooltip-text">Main Menu</property>
                  </object>
                </child>
                <child type="end">
                  <object class="GtkButton" id="searchSessionsBtn">
                    <property name="icon-name">system-search-symbolic</property>
                    <property name="tooltip-text">Search Sessions &amp; Projects (Ctrl+K)</property>
                  </object>
                </child>
              </object>
            </child>
            <property name="content">
              <object class="GtkScrolledWindow" id="sidebarScroll">
                <property name="hscrollbar-policy">never</property>
                <property name="vexpand">true</property>
                <property name="child">
                  <object class="GtkListBox" id="sidebarList">
                    <property name="selection-mode">single</property>
                    <property name="activate-on-single-click">true</property>
                    <property name="tab-behavior">item</property>
                    <style>
                      <class name="navigation-sidebar"/>
                      <class name="glup-sidebar-list"/>
                    </style>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </property>
        <child type="overlay">
          <object class="GtkBox" id="sidebarResizeHandle">
            <property name="halign">end</property>
            <property name="vexpand">true</property>
            <property name="width-request">6</property>
            <style>
              <class name="glup-sidebar-resizer"/>
            </style>
          </object>
        </child>
      </object>
    </property>

    <property name="content">
      <object class="AdwBottomSheet" id="bottomSheet">
        <property name="can-open">true</property>
        <property name="can-close">true</property>
        <property name="modal">true</property>
        <property name="show-drag-handle">true</property>
        <property name="reveal-bottom-bar">true</property>

        <property name="content">
          <object class="AdwToolbarView" id="contentToolbar">
            <property name="top-bar-style">flat</property>
            <child type="top">
              <object class="AdwHeaderBar" id="contentHeader">
                <property name="show-start-title-buttons">false</property>
                <child type="start">
                  <object class="GtkButton" id="showSidebarBtn">
                    <property name="icon-name">sidebar-show-symbolic</property>
                    <property name="tooltip-text">Show Sidebar</property>
                  </object>
                </child>
                <child type="start">
                  <object class="GtkMenuButton" id="appMenuTopBtn">
                    <property name="icon-name">view-more-symbolic</property>
                    <property name="tooltip-text">Main Menu</property>
                    <property name="visible">false</property>
                  </object>
                </child>
                <child type="start">
                  <object class="GtkButton" id="searchSessionsTopBtn">
                    <property name="icon-name">system-search-symbolic</property>
                    <property name="tooltip-text">Search Sessions &amp; Projects (Ctrl+K)</property>
                    <property name="visible">false</property>
                  </object>
                </child>
                <property name="title-widget">
                  <object class="GtkStack" id="headerTitleStack">
                    <property name="transition-type">none</property>
                    <property name="hhomogeneous">false</property>
                    <property name="vhomogeneous">false</property>
                    <property name="hexpand">true</property>
                    <child>
                      <object class="GtkStackPage">
                        <property name="name">title</property>
                        <property name="child">
                          <object class="GtkMenuButton" id="windowTitleBtn">
                            <property name="halign">center</property>
                            <property name="valign">center</property>
                            <property name="sensitive">false</property>
                            <property name="tooltip-text">Rename Session</property>
                            <style>
                              <class name="flat"/>
                              <class name="glup-window-title-btn"/>
                            </style>
                            <property name="child">
                              <object class="AdwWindowTitle" id="windowTitle">
                                <property name="title">Gluppencode</property>
                                <property name="subtitle">Select or create a session</property>
                              </object>
                            </property>
                            <property name="popover">
                              <object class="GtkPopover" id="renameSessionPopover">
                                <property name="has-arrow">false</property>
                                <property name="child">
                                  <object class="GtkBox">
                                    <property name="orientation">horizontal</property>
                                    <property name="spacing">6</property>
                                    <property name="width-request">340</property>
                                    <style>
                                      <class name="glup-popover-content"/>
                                    </style>
                                    <child>
                                      <object class="GtkEntry" id="renameSessionEntry">
                                        <property name="hexpand">true</property>
                                        <property name="placeholder-text">Session name…</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkButton" id="renameSessionSaveBtn">
                                        <property name="label">Rename</property>
                                        <style>
                                          <class name="suggested-action"/>
                                        </style>
                                      </object>
                                    </child>
                                  </object>
                                </property>
                              </object>
                            </property>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkStackPage">
                        <property name="name">breadcrumb</property>
                        <property name="child">
                          <object class="GtkBox" id="breadcrumbBox">
                            <property name="orientation">horizontal</property>
                            <property name="spacing">6</property>
                            <property name="halign">center</property>
                            <property name="valign">center</property>
                            <child>
                              <object class="GtkButton" id="breadcrumbParentBtn">
                                <property name="tooltip-text">Back to Main Conversation</property>
                                <style>
                                  <class name="flat"/>
                                  <class name="glup-breadcrumb-parent"/>
                                </style>
                                <property name="child">
                                  <object class="GtkLabel" id="breadcrumbParentLabel">
                                    <property name="ellipsize">end</property>
                                    <property name="max-width-chars">28</property>
                                  </object>
                                </property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label">&gt;</property>
                                <style>
                                  <class name="dim-label"/>
                                </style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="breadcrumbChildLabel">
                                <property name="ellipsize">end</property>
                                <property name="max-width-chars">36</property>
                                <style>
                                  <class name="heading"/>
                                </style>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </child>
                  </object>
                </property>
                <child type="end">
                  <object class="GtkButton" id="newWindowBtn">
                    <property name="icon-name">window-new-symbolic</property>
                    <property name="tooltip-text">New Window (Ctrl+Shift+N)</property>
                  </object>
                </child>
                <child type="end">
                  <object class="GtkButton" id="refreshBtn">
                    <property name="icon-name">refresh-symbolic</property>
                    <property name="tooltip-text">Refresh Sessions</property>
                  </object>
                </child>
                <child type="end">
                  <object class="GtkToggleButton" id="takeChargeBtn">
                    <property name="icon-name">auto-mode-symbolic</property>
                    <property name="tooltip-text">Take Charge: Off — click to auto-answer questions while away</property>
                    <style>
                      <class name="glup-take-charge-btn"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>

            <property name="content">
              <!-- The composer floats over the timeline so messages scroll
                   (dimmed) behind it; see applyComposerInset. -->
              <object class="GtkOverlay" id="contentOverlay">
                <property name="child">
                  <object class="GtkBox" id="contentMainBox">
                    <property name="orientation">vertical</property>
                    <property name="vexpand">true</property>
                    <property name="hexpand">true</property>
                    <child>
                      <object class="GtkOverlay" id="viewStackOverlay">
                        <property name="vexpand">true</property>
                        <property name="hexpand">true</property>
                        <property name="child">
                          <object class="AdwViewStack" id="viewStack">
                            <property name="hhomogeneous">false</property>
                            <property name="vhomogeneous">false</property>
                            <property name="vexpand">true</property>
                            <property name="hexpand">true</property>
                          </object>
                        </property>
                      </object>
                    </child>
                  </object>
                </property>
                <child type="overlay">
                  <!-- Fade ramp directly above the composer; positioned in Go. -->
                  <object class="GtkBox" id="timelineBottomFade">
                    <property name="can-target">false</property>
                    <style>
                      <class name="glup-timeline-bottom-fade"/>
                    </style>
                  </object>
                </child>
                <child type="overlay">
                  <object class="GtkBox" id="composerBar">
                    <property name="valign">end</property>
                    <property name="orientation">vertical</property>
                    <property name="spacing">0</property>
                    <style>
                      <class name="glup-composer-bar"/>
                    </style>
                    <child>
                      <object class="AdwClamp" id="composerClamp">
                        <property name="maximum-size">920</property>
                        <property name="tightening-threshold">680</property>
                        <property name="child">
                          <object class="GtkBox" id="composerFrame">
                            <property name="orientation">vertical</property>
                            <property name="spacing">4</property>
                            <style>
                              <class name="glup-composer-frame"/>
                            </style>
                            <child>
                              <object class="AdwWrapBox" id="attachmentTray">
                                <property name="child-spacing">8</property>
                                <property name="line-spacing">8</property>
                                <property name="visible">false</property>
                                <style>
                                  <class name="glup-attachment-tray"/>
                                </style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkOverlay" id="inputOverlay">
                                <property name="hexpand">true</property>
                                <property name="child">
                                  <object class="GtkScrolledWindow" id="inputScroll">
                                    <property name="hscrollbar-policy">never</property>
                                    <property name="vscrollbar-policy">external</property>
                                    <property name="max-content-height">140</property>
                                    <property name="propagate-natural-height">true</property>
                                    <property name="hexpand">true</property>
                                    <property name="child">
                                      <object class="GtkSourceView" id="inputView">
                                        <property name="wrap-mode">word-char</property>
                                        <property name="accepts-tab">true</property>
                                        <property name="show-line-numbers">false</property>
                                        <property name="highlight-current-line">false</property>
                                        <property name="hexpand">true</property>
                                        <style>
                                          <class name="glup-composer-text"/>
                                        </style>
                                      </object>
                                    </property>
                                  </object>
                                </property>
                                <child type="overlay">
                                  <object class="GtkLabel" id="composerPlaceholder">
                                    <property name="label">Ask anything, @ to mention, / for actions</property>
                                    <property name="halign">start</property>
                                    <property name="valign">start</property>
                                    <property name="can-target">false</property>
                                    <style>
                                      <class name="dim-label"/>
                                      <class name="glup-composer-placeholder"/>
                                    </style>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox" id="composerControlsRow">
                                <property name="orientation">horizontal</property>
                                <property name="spacing">6</property>
                                <property name="valign">center</property>
                                <child>
                                  <object class="GtkButton" id="attachBtn">
                                    <property name="icon-name">list-add-symbolic</property>
                                    <property name="valign">center</property>
                                    <property name="tooltip-text">Attach Image</property>
                                    <style>
                                      <class name="flat"/>
                                      <class name="circular"/>
                                      <class name="glup-composer-flat-btn"/>
                                    </style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkMenuButton" id="composerAgentBtn">
                                    <property name="direction">up</property>
                                    <property name="valign">center</property>
                                    <property name="tooltip-text">Select Agent</property>
                                    <style>
                                      <class name="flat"/>
                                      <class name="glup-composer-selector-btn"/>
                                    </style>
                                    <property name="popover">
                                      <object class="GtkPopover" id="agentPopover">
                                        <property name="position">top</property>
                                        <property name="has-arrow">false</property>
                                        <property name="child">
                                          <object class="GtkBox">
                                            <property name="orientation">vertical</property>
                                            <property name="spacing">8</property>
                                            <property name="width-request">260</property>
                                            <style>
                                              <class name="glup-popover-content"/>
                                            </style>
                                            <child>
                                              <object class="GtkListBox" id="agentListBox">
                                                <property name="selection-mode">single</property>
                                                <style>
                                                  <class name="boxed-list"/>
                                                </style>
                                              </object>
                                            </child>
                                          </object>
                                        </property>
                                      </object>
                                    </property>
                                    <property name="child">
                                      <object class="GtkLabel" id="agentPillLabel">
                                        <property name="label">Build</property>
                                        <property name="valign">center</property>
                                        <style>
                                          <class name="glup-agent-pill-label"/>
                                        </style>
                                      </object>
                                    </property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkMenuButton" id="composerModelBtn">
                                    <property name="direction">up</property>
                                    <property name="valign">center</property>
                                    <property name="tooltip-text">Select Model</property>
                                    <style>
                                      <class name="flat"/>
                                      <class name="glup-composer-selector-btn"/>
                                    </style>
                                    <property name="popover">
                                      <object class="GtkPopover" id="modelPopover">
                                        <property name="position">top</property>
                                        <property name="has-arrow">false</property>
                                        <property name="child">
                                          <object class="GtkBox">
                                            <property name="orientation">vertical</property>
                                            <property name="spacing">8</property>
                                            <property name="width-request">360</property>
                                            <style>
                                              <class name="glup-popover-content"/>
                                            </style>
                                            <child>
                                              <object class="GtkSearchEntry" id="modelSearchEntry">
                                                <property name="placeholder-text">Filter models…</property>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="GtkScrolledWindow">
                                                <property name="hscrollbar-policy">never</property>
                                                <property name="vscrollbar-policy">automatic</property>
                                                <property name="propagate-natural-height">true</property>
                                                <property name="max-content-height">320</property>
                                                <property name="width-request">360</property>
                                                <property name="child">
                                                  <object class="GtkListBox" id="modelListBox">
                                                    <property name="selection-mode">single</property>
                                                    <style>
                                                      <class name="boxed-list"/>
                                                    </style>
                                                  </object>
                                                </property>
                                              </object>
                                            </child>
                                          </object>
                                        </property>
                                      </object>
                                    </property>
                                    <property name="child">
                                      <object class="GtkLabel" id="modelStatusLabel">
                                        <property name="label">Model</property>
                                        <property name="valign">center</property>
                                        <property name="ellipsize">end</property>
                                        <style>
                                          <class name="glup-model-status-label"/>
                                        </style>
                                      </object>
                                    </property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkBox">
                                    <property name="hexpand">true</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkButton" id="sendBtn">
                                    <property name="icon-name">paper-plane-symbolic</property>
                                    <property name="valign">center</property>
                                    <property name="tooltip-text">Queue Prompt (Enter) · Steer Immediately (Ctrl+Enter)</property>
                                    <style>
                                      <class name="suggested-action"/>
                                      <class name="circular"/>
                                      <class name="glup-send-btn"/>
                                    </style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkButton" id="stopBtn">
                                    <property name="icon-name">stop-circle-symbolic</property>
                                    <property name="valign">center</property>
                                    <property name="tooltip-text">Interrupt Session</property>
                                    <property name="visible">false</property>
                                    <style>
                                      <class name="destructive-action"/>
                                      <class name="circular"/>
                                      <class name="glup-send-btn"/>
                                    </style>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <!-- Spacer so the persistent AdwBottomSheet bottom-bar doesn't cover the composer -->
                      <object class="GtkBox" id="bottomBarSpacer">
                        <property name="height-request">46</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </property>

        <property name="bottom-bar">
          <object class="GtkBox" id="statusBarBox">
            <property name="orientation">horizontal</property>
            <property name="spacing">8</property>
            <property name="halign">fill</property>
            <property name="hexpand">true</property>
            <style>
              <class name="glup-status-bar"/>
            </style>
            <child>
              <object class="GtkBox" id="projectStatusBox">
                <property name="orientation">horizontal</property>
                <property name="spacing">5</property>
                <property name="halign">start</property>
                <property name="valign">center</property>
                <style>
                  <class name="glup-status-chip"/>
                  <class name="glup-status-project"/>
                </style>
                <child>
                  <object class="GtkImage">
                    <property name="icon-name">folder-symbolic</property>
                    <property name="pixel-size">14</property>
                    <property name="valign">center</property>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="projectStatusLabel">
                    <property name="label">project</property>
                    <property name="xalign">0</property>
                    <property name="valign">center</property>
                    <property name="ellipsize">end</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="branchStatusBox">
                <property name="orientation">horizontal</property>
                <property name="spacing">5</property>
                <property name="halign">start</property>
                <property name="valign">center</property>
                <property name="visible">false</property>
                <style>
                  <class name="glup-status-chip"/>
                  <class name="glup-status-project"/>
                </style>
                <child>
                  <object class="GtkImage">
                    <property name="icon-name">git-branch-symbolic</property>
                    <property name="pixel-size">14</property>
                    <property name="valign">center</property>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="branchStatusLabel">
                    <property name="label">main</property>
                    <property name="xalign">0</property>
                    <property name="valign">center</property>
                    <property name="ellipsize">end</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="mcpStatusBox">
                <property name="orientation">horizontal</property>
                <property name="spacing">5</property>
                <property name="halign">start</property>
                <property name="valign">center</property>
                <property name="visible">false</property>
                <style>
                  <class name="glup-status-chip"/>
                  <class name="glup-status-mcp"/>
                </style>
                <child>
                  <object class="GtkImage">
                    <property name="icon-name">bolt-symbolic</property>
                    <property name="pixel-size">14</property>
                    <property name="valign">center</property>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="mcpStatusLabel">
                    <property name="label">0 MCP</property>
                    <property name="valign">center</property>
                    <property name="ellipsize">end</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox">
                <property name="hexpand">true</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="backgroundStatusBtn">
                <property name="valign">center</property>
                <property name="visible">false</property>
                <property name="tooltip-text">Move blocking work to background (Ctrl+B)</property>
                <style>
                  <class name="flat"/>
                  <class name="glup-status-chip"/>
                  <class name="glup-status-background"/>
                </style>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">horizontal</property>
                    <property name="spacing">5</property>
                    <property name="valign">center</property>
                    <child>
                      <object class="GtkImage">
                        <property name="icon-name">arrow-downward-symbolic</property>
                        <property name="pixel-size">14</property>
                        <property name="valign">center</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">Ctrl+B to background</property>
                        <property name="valign">center</property>
                        <property name="ellipsize">end</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="shellStatusBox">
                <property name="orientation">horizontal</property>
                <property name="spacing">5</property>
                <property name="valign">center</property>
                <property name="visible">false</property>
                <style>
                  <class name="glup-status-chip"/>
                  <class name="glup-status-shells"/>
                </style>
                <child>
                  <object class="GtkImage">
                    <property name="icon-name">terminal-symbolic</property>
                    <property name="pixel-size">14</property>
                    <property name="valign">center</property>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="shellStatusLabel">
                    <property name="label">0 shells</property>
                    <property name="valign">center</property>
                    <property name="ellipsize">end</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="subagentStatusBox">
                <property name="orientation">horizontal</property>
                <property name="spacing">5</property>
                <property name="valign">center</property>
                <property name="visible">false</property>
                <style>
                  <class name="glup-status-chip"/>
                  <class name="glup-status-subagents"/>
                </style>
                <child>
                  <object class="GtkImage">
                    <property name="icon-name">arrow-downward-symbolic</property>
                    <property name="pixel-size">14</property>
                    <property name="valign">center</property>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="subagentStatusLabel">
                    <property name="label">0 subagents</property>
                    <property name="valign">center</property>
                    <property name="ellipsize">end</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="tokRateStatusLabel">
                <property name="label">0.0 tok/s</property>
                <property name="valign">center</property>
                <property name="ellipsize">end</property>
                <property name="visible">false</property>
                <style>
                  <class name="glup-status-chip"/>
                  <class name="glup-status-tokrate"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="contextStatusLabel">
                <property name="label">0K</property>
                <property name="valign">center</property>
                <property name="ellipsize">end</property>
                <style>
                  <class name="glup-status-chip"/>
                  <class name="glup-status-context"/>
                </style>
              </object>
            </child>
          </object>
        </property>

        <property name="sheet">
          <object class="AdwToastOverlay" id="sheetToastOverlay">
            <property name="child">
              <object class="AdwNavigationView" id="sheetNavView">
                <property name="vhomogeneous">false</property>
                <property name="hhomogeneous">false</property>
                <child>
                  <object class="AdwNavigationPage" id="sheetOverviewPage">
                    <property name="title">Overview</property>
                    <property name="tag">overview</property>
                    <property name="child">
                      <object class="GtkScrolledWindow">
                        <property name="hscrollbar-policy">never</property>
                        <property name="vscrollbar-policy">automatic</property>
                        <property name="propagate-natural-height">true</property>
                        <property name="max-content-height">580</property>
                        <property name="child">
                          <object class="AdwClamp">
                            <property name="maximum-size">680</property>
                            <property name="child">
                              <object class="GtkBox" id="sheetContentBox">
                                <property name="orientation">vertical</property>
                                <property name="spacing">14</property>
                                <style>
                                  <class name="glup-sheet-content"/>
                                </style>
                                <child>
                                  <object class="GtkLabel" id="sheetEmptyLabel">
                                    <property name="label">No active shells, subagents, or MCP servers</property>
                                    <property name="wrap">true</property>
                                    <property name="justify">center</property>
                                    <property name="halign">center</property>
                                    <property name="valign">center</property>
                                    <property name="vexpand">true</property>
                                    <property name="margin-top">28</property>
                                    <property name="margin-bottom">28</property>
                                    <style>
                                      <class name="dim-label"/>
                                    </style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkBox" id="shellsSectionBox">
                                    <property name="orientation">vertical</property>
                                    <property name="spacing">8</property>
                                    <property name="visible">false</property>
                                    <child>
                                      <object class="GtkLabel">
                                        <property name="label">Active Shells</property>
                                        <property name="xalign">0</property>
                                        <property name="hexpand">true</property>
                                        <style>
                                          <class name="heading"/>
                                        </style>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkListBox" id="shellListBox">
                                        <property name="selection-mode">none</property>
                                        <style>
                                          <class name="boxed-list"/>
                                        </style>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkBox" id="subagentsSectionBox">
                                    <property name="orientation">vertical</property>
                                    <property name="spacing">8</property>
                                    <property name="visible">false</property>
                                    <child>
                                      <object class="GtkBox">
                                        <property name="orientation">horizontal</property>
                                        <property name="spacing">8</property>
                                        <child>
                                          <object class="GtkLabel">
                                            <property name="label">Subagents</property>
                                            <property name="xalign">0</property>
                                            <property name="hexpand">true</property>
                                            <style>
                                              <class name="heading"/>
                                            </style>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkButton" id="sheetBackToParentBtn">
                                            <property name="label">Back to Main Conversation</property>
                                            <property name="visible">false</property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkListBox" id="subagentListBox">
                                        <property name="selection-mode">none</property>
                                        <style>
                                          <class name="boxed-list"/>
                                        </style>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkBox" id="mcpSectionBox">
                                    <property name="orientation">vertical</property>
                                    <property name="spacing">8</property>
                                    <property name="visible">false</property>
                                    <child>
                                      <object class="GtkBox">
                                        <property name="orientation">horizontal</property>
                                        <property name="spacing">8</property>
                                        <child>
                                          <object class="GtkLabel">
                                            <property name="label">MCP Servers</property>
                                            <property name="xalign">0</property>
                                            <property name="valign">center</property>
                                            <style>
                                              <class name="heading"/>
                                            </style>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkLabel" id="mcpDirLabel">
                                            <property name="xalign">0</property>
                                            <property name="hexpand">true</property>
                                            <property name="ellipsize">start</property>
                                            <property name="valign">center</property>
                                            <style>
                                              <class name="caption"/>
                                              <class name="dim-label"/>
                                            </style>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkButton" id="mcpAllLogsBtn">
                                            <property name="tooltip-text">View All MCP Logs</property>
                                            <property name="valign">center</property>
                                            <style>
                                              <class name="flat"/>
                                            </style>
                                            <child>
                                              <object class="GtkBox">
                                                <property name="orientation">horizontal</property>
                                                <property name="spacing">5</property>
                                                <child>
                                                  <object class="GtkImage">
                                                    <property name="icon-name">summarize-symbolic</property>
                                                    <property name="pixel-size">14</property>
                                                  </object>
                                                </child>
                                                <child>
                                                  <object class="GtkLabel">
                                                    <property name="label">Logs</property>
                                                  </object>
                                                </child>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkButton" id="mcpRefreshBtn">
                                            <property name="icon-name">refresh-symbolic</property>
                                            <property name="tooltip-text">Refresh MCP Status</property>
                                            <property name="valign">center</property>
                                            <style>
                                              <class name="flat"/>
                                              <class name="circular"/>
                                            </style>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="AdwBanner" id="mcpErrBanner">
                                        <property name="use-markup">false</property>
                                        <property name="button-label">Retry</property>
                                        <property name="revealed">false</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkSearchEntry" id="mcpSearchEntry">
                                        <property name="placeholder-text">Filter MCP servers…</property>
                                        <property name="visible">false</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkStack" id="mcpListStack">
                                        <property name="vhomogeneous">false</property>
                                        <property name="hhomogeneous">false</property>
                                        <child>
                                          <object class="GtkStackPage">
                                            <property name="name">list</property>
                                            <property name="child">
                                              <object class="GtkListBox" id="mcpListBox">
                                                <property name="selection-mode">none</property>
                                                <property name="valign">start</property>
                                                <style>
                                                  <class name="boxed-list"/>
                                                </style>
                                              </object>
                                            </property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkStackPage">
                                            <property name="name">empty</property>
                                            <property name="child">
                                              <object class="AdwStatusPage">
                                                <property name="icon-name">bolt-symbolic</property>
                                                <property name="title">No MCP Servers Configured</property>
                                                <property name="description">Add servers under "mcp.servers" in opencode.json to manage them here.</property>
                                                <style>
                                                  <class name="compact"/>
                                                </style>
                                              </object>
                                            </property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkStackPage">
                                            <property name="name">filtered-empty</property>
                                            <property name="child">
                                              <object class="AdwStatusPage">
                                                <property name="icon-name">system-search-symbolic</property>
                                                <property name="title">No Matching Servers</property>
                                                <property name="description">Try a different search query.</property>
                                                <style>
                                                  <class name="compact"/>
                                                </style>
                                              </object>
                                            </property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkStackPage">
                                            <property name="name">loading</property>
                                            <property name="child">
                                              <object class="GtkBox">
                                                <property name="orientation">vertical</property>
                                                <property name="spacing">8</property>
                                                <property name="halign">center</property>
                                                <property name="valign">center</property>
                                                <property name="margin-top">18</property>
                                                <property name="margin-bottom">18</property>
                                                <child>
                                                  <object class="AdwSpinner">
                                                    <property name="width-request">28</property>
                                                    <property name="height-request">28</property>
                                                  </object>
                                                </child>
                                              </object>
                                            </property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkBox" id="contextSectionBox">
                                    <property name="orientation">vertical</property>
                                    <property name="spacing">8</property>
                                    <property name="visible">false</property>
                                    <child>
                                      <object class="GtkLabel">
                                        <property name="label">Session &amp; Context</property>
                                        <property name="xalign">0</property>
                                        <property name="hexpand">true</property>
                                        <style>
                                          <class name="heading"/>
                                        </style>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkBox" id="contextSessionIDBox">
                                        <property name="orientation">horizontal</property>
                                        <property name="spacing">8</property>
                                        <property name="hexpand">true</property>
                                        <style>
                                          <class name="glup-context-grid"/>
                                        </style>
                                        <child>
                                          <object class="GtkBox">
                                            <property name="orientation">vertical</property>
                                            <property name="spacing">2</property>
                                            <property name="hexpand">true</property>
                                            <property name="valign">center</property>
                                            <style>
                                              <class name="glup-context-cell"/>
                                            </style>
                                            <child>
                                              <object class="GtkLabel">
                                                <property name="label">Conversation ID</property>
                                                <property name="xalign">0</property>
                                                <style>
                                                  <class name="glup-context-cell-label"/>
                                                </style>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="GtkLabel" id="contextSessionIDLabel">
                                                <property name="xalign">0</property>
                                                <property name="selectable">true</property>
                                                <property name="ellipsize">middle</property>
                                                <style>
                                                  <class name="glup-context-cell-value"/>
                                                </style>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkButton" id="copySessionIDBtn">
                                            <property name="icon-name">edit-copy-symbolic</property>
                                            <property name="tooltip-text">Copy Conversation ID</property>
                                            <property name="valign">center</property>
                                            <style>
                                              <class name="flat"/>
                                            </style>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkGrid" id="contextInfoGrid">
                                        <property name="column-spacing">16</property>
                                        <property name="row-spacing">12</property>
                                        <property name="column-homogeneous">true</property>
                                        <property name="hexpand">true</property>
                                        <style>
                                          <class name="glup-context-grid"/>
                                        </style>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </property>
                          </object>
                        </property>
                      </object>
                    </property>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </property>
      </object>
    </property>
  </object>
</interface>
